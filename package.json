{
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.0",
    "svelte-check": "^4.2.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "name": "openmovies",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy:api": "python3 scripts/deploy-api.py",
    "deploy:web": "python3 scripts/deploy-web.py",
    "dev": "vite dev --port 4322 --strictPort",
    "preview": "vite preview --port 4322",
    "test": "vitest run"
  },
  "type": "module",
